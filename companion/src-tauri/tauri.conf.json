{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whisdom Companion",
  "version": "0.0.1",
  "identifier": "app.whisdom.companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Whisdom",
        "url": "index.html",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; script-src-elem 'self' 'unsafe-inline' https://accounts.google.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: tauri: asset: http:; media-src 'self' blob:; connect-src 'self' https: http: tauri: ipc: http://ipc.localhost ws: wss: blob:; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5RDBGMEY3QjM0NjE1QjMKUldTekZVYXo5L0RRNmRtQ2xZWE1UUmloSkZtbjBvTlord3hTTStPRS9uZ0hiRk1ZYlJKd3RYbHkK",
      "endpoints": [
        "https://github.com/teppyboy/whisdom/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "resources": {},
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}